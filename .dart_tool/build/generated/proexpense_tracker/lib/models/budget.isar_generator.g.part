int _budgetEstimateSize(
  Budget object,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  var bytesCount = offsets.last;
  bytesCount += 3 + object.category.length * 3;
  bytesCount += 3 + object.period.length * 3;
  return bytesCount;
}

void _budgetSerialize(
  Budget object,
  IsarWriter writer,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  writer.writeDouble(offsets[0], object.amount);
  writer.writeString(offsets[1], object.category);
  writer.writeDateTime(offsets[2], object.endDate);
  writer.writeBool(offsets[3], object.isActive);
  writer.writeDouble(offsets[4], object.percentageUsed);
  writer.writeString(offsets[5], object.period);
  writer.writeDouble(offsets[6], object.remainingAmount);
  writer.writeDouble(offsets[7], object.spentAmount);
  writer.writeDateTime(offsets[8], object.startDate);
}

Budget _budgetDeserialize(
  Id id,
  IsarReader reader,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  final object = Budget();
  object.amount = reader.readDouble(offsets[0]);
  object.category = reader.readString(offsets[1]);
  object.endDate = reader.readDateTimeOrNull(offsets[2]);
  object.id = id;
  object.isActive = reader.readBool(offsets[3]);
  object.period = reader.readString(offsets[5]);
  object.startDate = reader.readDateTime(offsets[8]);
  return object;
}

